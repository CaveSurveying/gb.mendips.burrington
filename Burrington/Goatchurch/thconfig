encoding  utf-8
source Goatchurch.th
# Change name to the main therion file


#Surveys to output
#-----------------

#export map -proj plan -layout local -o Goatchurch.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o GoatchurchEe.pdf

#export map -proj [elevation 90] -layout local -o GoatchurchE90.pdf

export model -fmt survex -o Goatchurchth.3d
#Survex file showing centre line only

export model -o Goatchurch.lox
#3d therion model to be viewed in the therion viewer


layout local
#copy common
map-header 50 100 ne
map-comment "Drawn in Therion by Stuart Alldred<br>Creative Commons BY NC SA" 
colour map-bg 90 
scale 1 150
scale-bar 10 m
symbol-hide group cave-centreline
#colour map-fg scrap 
#debug on 
#debug scrap-names 
transparency off
layers off
endlayout
