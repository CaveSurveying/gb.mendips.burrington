encoding  utf-8
survey ZAlley

input ZAlley.th2
input ZAlleyE15.th2

map ZAlleyM
  ZAlleySP1
 break
  ZAlleySP2
 break
  ZAlleySP3
endmap

map ZAlleyME15 -proj [elevation 15]
  ZAlleySE15_1
  ZAlleySE15_2
  ZAlleySE15_3
  ZAlleySE15_4
endmap
