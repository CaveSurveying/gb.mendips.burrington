point 240.0 200.0 label -text "f1" -align c -scale s

point 720.0 440.0 section -scrap "LLAproachSPX8.8" -align t

point 720.0 200.0 label -text "f4" -align c -scale s

point 1200.0 440.0 section -scrap "LLAproachSPX8.6" -align t

point 1200.0 200.0 label -text "f3" -align c -scale s

point 1680.0 440.0 section -scrap "LLAproachSPX8.2" -align t

point 1680.0 200.0 label -text "f2" -align c -scale s

endscrap