#Plan: join to points on line would be better
#15: not needed
join JuncAlterRoute2SE105_1@JuncAlterRoute2 MainChamberSE105_1@MainChamber -smooth on

equate 1@JunctionChamber 53@OffShoot3
join JunctionChamberSP1@JunctionChamber OffShoot3SP1@OffShoot3 -smooth on
