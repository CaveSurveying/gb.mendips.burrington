map ReadsM
  Reads1M [0 -40 m] below
  Reads2M [0 -65 m] below
  Reads3M [0 -90 m] below
  Reads4M [0 -115 m] below
endmap

map LevelsM
  Level1M [0 -40 m] below
  Level2M [0 -65 m] below
  Level3M [0 -90 m] below
  Level4M [0 -115 m] below
endmap

map Reads1M
  Level1M [0 -40 m] below
  preview below Level2M 
  preview below Level3M 
  preview below Level4M
endmap

map Reads2M
  preview below Level1M
  Level2M 
  preview above Level3M
  preview above Level4M
endmap

map Reads3M
  preview below Level1M
  preview below Level2M 
  Level3M
  preview above Level4M
endmap

map Reads4M
  preview below Level1M
  preview below Level2M 
  preview below Level3M
  Level4M
endmap

