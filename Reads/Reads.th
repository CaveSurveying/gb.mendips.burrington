equate 81@AltJunctTinyBit 30@JuncAlterRoute2
#No joins needed

equate 54@BoulderChamber 3.2@Water
#Plan -not needed
join BoulderChamberSE15_1@BoulderChamber WaterSE15_1@Water -smooth on
join BoulderChamberSE105_1@BoulderChamber WaterSE105_1@Water -smooth on


equate 61@BoulderChamber 70@BoulderChamberRoute2
join BoulderChamberSP3@BoulderChamber BoulderChamberRoute2SP1@BoulderChamberRoute2 -smooth on
join BoulderChamberSP3@BoulderChamber BoulderChamberRoute2SP2@BoulderChamberRoute2 -smooth on
