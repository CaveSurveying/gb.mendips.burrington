join MainChamberSE105_1@MainChamber PipeSE105_1@Pipe -smooth on

equate 2.7@MainChamber 3.0@Water
join MainChamberSPl1@MainChamber WaterSP1@Water -smooth on
#15: Might be better with a point join
#105: No idea

equate 2.9@MainChamber 42@WCR2
#Plan: 3 way join, sigh, probably better if it had point joins
#15: not needed
join MainChamberSE105_1@MainChamber WCR2SE105_1@WCR2 -smooth on

equate 0@Maze 5.9@ZAlley
