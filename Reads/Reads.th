join JuncAlterRouteSE15_2@JuncAlterRoute JuncAlterRoute2SE15_2@JuncAlterRoute2 -smooth on
join JuncAlterRouteSE105_2@JuncAlterRoute JuncAlterRoute2SE105_1@JuncAlterRoute2 -smooth on

