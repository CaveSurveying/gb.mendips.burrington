encoding  utf-8
survey Reads

input AltJunctTinyBit/AltJunctTinyBit.th
input BoulderChamber/BoulderChamber.th
input BoulderChamberRoute2/BoulderChamberRoute2.th
input BrownStain/BrownStain.th
input BrowneStewart/BrowneStewart.th
input BrownStuart/BrownStuart.th
input DryEnt/DryEnt.th
input DeathWish/DeathWish.th
input EarlyGrave/EarlyGrave.th
input Grotto/Grotto.th
input JCAlt/JCAlt.th
input JuncAlterRoute/JuncAlterRoute.th
input JuncAlterRoute2/JuncAlterRoute2.th
input JunctionChamber/JunctionChamber.th
input LastSurveyingChamber/LastSurveyingChamber.th
input LADSLuck/LADSLuck.th
input LLAproach/LLAproach.th
input LlExtension/LlExtension.th
input LowerMaze/LowerMaze.th
input MainChamber/MainChamber.th
input Maze/Maze.th
input MNRCSeries/MNRCSeries.th
input OffShoot/OffShoot.th
input OffShoot2/OffShoot2.th
input OffShoot3/OffShoot3.th
input Pipe/Pipe.th
input SplashPot/SplashPot.th
input SudoLinkTube/SudoLinkTube.th
#input TheSweetEnd/TheSweetEnd.th #This has been resurveyed as DeathWish
input UpperWaterfall/UpperWaterfall.th
input UpperWaterfall2/UpperWaterfall2.th
input Water/Water.th
input WaterfallChamber/WaterfallChamber.th
input WCR2/WCR2.th
input ZAlley/ZAlley.th

equate 81@AltJunctTinyBit 30@JuncAlterRoute2
equate 54@BoulderChamber 3.2@Water
equate 61@BoulderChamber 70@BoulderChamberRoute2
equate 20@BoulderChamberRoute2 9@OffShoot
equate 8.37@BrownStain 8.20@LLAproach
equate 22@BrowneStewart 7.23@BrownStuart
equate 19@BrowneStewart 8.4@LLAproach
equate 14@BrowneStewart 14@JunctionChamber
equate 7.9@BrownStuart 8.22@LLAproach
equate 7.12@BrownStuart 8.19@LLAproach
equate 7.22@BrownStuart 8.0@LLAproach
equate 7.0@BrownStuart 6.23@SplashPot 
equate 1.6@DryEnt 2.0@MainChamber
equate 9.46@EarlyGrave 9.46@LADSLuck
equate 85@Grotto 2.1@MainChamber
equate 7@JCAlt 7@JunctionChamber
equate 26@JCAlt 1@JunctionChamber
equate 28@JCAlt 1@JuncAlterRoute
equate 14@JuncAlterRoute 14@JuncAlterRoute2
equate 42@JuncAlterRoute2 2.9@MainChamber
equate 1@JunctionChamber 53@OffShoot3
equate 15@LastSurveyingChamber 15@LowerMaze
equate 8.12@LLAproach 9.0@LADSLuck
equate 8.12@LLAproach 8.23@LlExtension
equate 8.15@LLAproach 8.30@SudoLinkTube
equate 0@LowerMaze 5.11@ZAlley
equate 18@LowerMaze 0@DeathWish
equate 2.1@MainChamber 4.0@Pipe
equate 2.7@MainChamber 3.0@Water
equate 2.9@MainChamber 42@WCR2
equate 0@Maze 5.9@ZAlley
equate 6.42@MNRCSeries 6.22@SplashPot
equate 10@OffShoot 10@OffShoot2
equate 16@OffShoot2 25@OffShoot3
equate 0@OffShoot 3.2@Water
equate 4.22@Pipe 0@UpperWaterfall
equate 4.23@Pipe 5.0@ZAlley
equate 6.0@SplashPot 5.15@ZAlley
equate 13@UpperWaterfall 14@UpperWaterfall2
equate 1@WaterfallChamber 5.10@ZAlley


map ReadsM
  Level1M
  Level2M
  Level3M
  Level4M
endmap


map Level1M
  DryEntM@DryEnt [0 -25 m] above
  GrottoM@Grotto [0 -25 m] above
  MainChamberM@MainChamber [0 -25 m] above
  JuncAlterRouteM@JuncAlterRoute [0 -25 m] above
  OffShootM@OffShoot [0 -25 m] above  
  WaterM@Water [0 -25 m] above
  WaterfallChamberM@WaterfallChamber [0 -25 m] above
endmap

map Level2M
  AltJunctTinyBitM@AltJunctTinyBit [0 -50 m] above
  BoulderChamberM@BoulderChamber [0 -50 m] above
  BoulderChamberRoute2M@BoulderChamberRoute2 [0 -50 m] above
  JCAltM@JCAlt [0 -50 m] above
  JuncAlterRoute2M@JuncAlterRoute2 [0 -50 m] above
  OffShoot2M@OffShoot2 [0 -50 m] above 
  OffShoot3M@OffShoot3 [0 -50 m] above 
  PipeM@Pipe [0 -50 m] above
  UpperWaterfallM@UpperWaterfall [0 -50 m] above
  UpperWaterfall2M@UpperWaterfall2 [0 -50 m] above
  WCR2M@WCR2 [0 -50 m] above #probably needs splitting into level1M
  ZAlleyM@ZAlley  [0 -50 m] above #probably needs splitting into level4M
endmap

map Level3M
  BrowneStewartM@BrowneStewart [0 -75 m] above
  EarlyGraveM@EarlyGrave [0 -75 m] above
  LADSLuckM@LADSLuck [0 -75 m] above
  LLAproachM@LLAproach [0 -75 m] above
  LlExtensionM@LlExtension [0 -75 m] above
  SudoLinkTubeM@SudoLinkTube [0 -75 m] above
endmap

map Level4M
  BrownStainM@BrownStain [0 -100 m] above
  BrownStuartM@BrownStuart [0 -100 m] above
  LastSurveyingChamberM@LastSurveyingChamber [0 -100 m] above
  LowerMazeM@LowerMaze [0 -100 m] above
  MazeM@Maze [0 -100 m] above
  MNRCSeriesM@MNRCSeries [0 -100 m] above
  SplashPotM@SplashPot [0 -100 m] above
  #TheSweetEndM@TheSweetEnd [0 -100 m] above
endmap

map ReadsME15 -proj [elevation 15]
  DryEntME15@DryEnt
  MainChamberME15@MainChamber
  #WaterM@Water
endmap

