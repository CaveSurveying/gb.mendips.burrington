equate 7.12@BrownStuart 8.19@LLAproach
equate 7.22@BrownStuart 8.0@LLAproach
equate 7.0@BrownStuart 6.23@SplashPot 
equate 1.6@DryEnt 2.0@MainChamber
equate 9.46@EarlyGrave 9.46@LADSLuck
equate 7@JCAlt 7@JunctionChamber
equate 26@JCAlt 1@JunctionChamber
equate 28@JCAlt 1@JuncAlterRoute
equate 14@JuncAlterRoute 14@JuncAlterRoute2
equate 42@JuncAlterRoute2 2.9@MainChamber
