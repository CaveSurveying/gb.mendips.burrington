map ReadsM
  DryEntM@DryEnt
  MainChamberM@MainChamber
  JuncAlterRoute2M@JuncAlterRoute2
  JuncAlterRouteM@JuncAlterRoute
  WaterM@Water
  WaterfallChamberM@WaterfallChamber
endmap

map ReadsME15 -proj [elevation 15]
  DryEntME15@DryEnt
  MainChamberME15@MainChamber
  #WaterM@Water
endmap

##############################################################
#PLAN Joins




##############################################################
#Projected Elevation Joins

join DryEntSE15_1@DryEnt MainChamberSE15_1@MainChamber -smooth on

endsurvey

