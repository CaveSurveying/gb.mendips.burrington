equate 15@LastSurveyingChamber 15@LowerMaze
#Plan: not needed
#15: could be inproved by point joining
#105: could be inproved by point joining

equate 8.12@LLAproach 9.0@LADSLuck
#equate is to LLAproach but stn is in LLExtensionM
join LADSLuckSP2@LADSLuck LlExtensionSP1@LlExtension -smooth on 
#Plan: LADSLuckSP2 would be better with point join to LlExtension
join LADSLuckSE15_3@LADSLuck LlExtensionSE15_1@LlExtension -smooth on
join LADSLuckSE15_1@LADSLuck LlExtensionSE15_1@LlExtension -smooth on
#105: too hard, probably not useful

equate 8.12@LLAproach 8.23@LlExtension
join LLAproachSP1@LLAproach LlExtensionSP1@LlExtension -smooth on
join LLAproachSE15_2@LLAproach LlExtensionSE15_1@LlExtension -smooth on
#105: too hard, probably not useful

