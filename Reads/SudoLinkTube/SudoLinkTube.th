encoding  utf-8
survey SudoLinkTube

input SudoLinkTube.th2
input SudoLinkTubeE15.th2
input SudoLinkTubeE105.th2

map SudoLinkTubeM
  SudoLinkTubeSP1
endmap

map SudoLinkTubeME15 -proj [elevation 15]
  SudoLinkTubeSE15_1
endmap

map SudoLinkTubeME105 -proj [elevation 105]
  SudoLinkTubeSE105_1
 break
  SudoLinkTubeSE105_2
endmap

