encoding  utf-8
survey WCR2

input WCR2.th2
input WCR2E15.th2
input WCR2E105.th2

map WCR2M
  WCR2SP1
  WCR2SP2
  WCR2SP3
  WCR2SP4
endmap

map WCR2ME15 -proj [elevation 15]
  WCR2SE15_1
endmap

map WCR2ME105 -proj [elevation 105]
  WCR2SE105_1
endmap

equate 52 80

centreline

