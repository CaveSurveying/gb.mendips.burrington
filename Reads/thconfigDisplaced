encoding  utf-8
source Reads.th

#This file has to be run first to produce the exploded elevations used in thconfig_noDisplaced

select ReadsM@Reads -map-level 1 #Displaces cave with level colour if map level 1
select ReadsME15@Reads -map-level 1
select ReadsME105@Reads -map-level 1


export map -proj [elevation 15] -layout local_elevation15 -o ReadsE15_Exploded.pdf

export map -proj [elevation 105] -layout local_elevation105 -o ReadsE105_Exploded.pdf

export map -proj plan -layout local_Plan -o Reads_Exploded.pdf 



layout local_Plan
  copy mendip
  overlap 0 mm
  #colour map-bg [90 40 85]
endcode
endlayout

layout local_elevation15
  copy local_elevation
  colour map-bg [75 90 75]
  symbol-hide point raft #labels to be hidden have been given -context point raft

endlayout

layout local_elevation105
  copy local_elevation
  colour map-bg [75 75 87]
endlayout

layout local_elevation
  copy mendip
  
endlayout

layout mendip
copy common
code tex-map 
  \def\maplayout{
      \legendbox{0}{100}{SW}{
      \comment{Exploded view}
      \size[25]\the\comment
      }
   }
endcode
debug off
grid off
scale 1 300
rotate -15
map-header 0 0 ne
map-header-bg off
colour map-bg transparent
scale-bar 50 m
#symbol-hide group all
symbol-hide group cave-centreline
colour map-fg map
overlap 5 mm

code metapost

#####################################
#Text sizes
#xs: features such as sumps
#s: point names such as rocks
#m: normal names
#l: major names
#xl: Area/cave names
#####################################

 # for scale 1 300
  fonts_setup(8,12,16,24,40)

endcode
endlayout

input ../common_layout.th
