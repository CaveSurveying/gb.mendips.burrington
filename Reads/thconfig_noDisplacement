#####################################
#                                PLEASE READ                                            #
#####################################
#The paths are absolute, so will not work from one computer to another.
#The solution below is suggested, but does not work on AAs machine

#The layouts use Tex, which stops map-image working,
#to get the relative files to work you need to set Tex to point to the root of the repository using
# export TEXINPUTS=.:/absolute/path/to/folder//:

layout local_Plan
  copy mendip
  legend on
  colour-legend off
  symbol-hide point label
  symbol-hide line label
  symbol-hide line section
  symbol-hide point section
  #legend-width 10 cm
code tex-map
  \def\loadpicture#1{\pdfximage{#1}\pdfrefximage\pdflastximage} 
  \def\maplayout{
      \legendbox{12}{5}{SW}{\northarrow}
      \legendbox{9}{100}{NE}{
              \hsize=\legendwidth
              \size[60]\the\cavename
              \vskip2cm
              \size[18]\the\cavelengthtitle: \the\cavelength\qquad
              \the\cavedepthtitle: \the\cavedepth
              \vskip.5cm
              \comment{Third angle projection}
              \size[18]\the\comment
              \vskip.5cm
              \scalebar
              \vskip.5cm
              \size[12]\the\topotitle\space
              \the\topoteam\space
              \the\topodate
              \medskip
              \comment={Drawn, using Therion, by Andrew Atkinson with help from Graham Mullan}
              \size[12]\the\comment
              \medskip
              \comment={With thanks to all the other cavers, past and present,}
              \size[12]\the\comment
              \smallskip
              \comment={that have helped and made information available.}
              \size[12]\the\comment
              \medskip
              \comment={Scale 1:300}
              \the\comment
              \qquad
              \comment={Grade UISv1 6-4-BEF}
              \the\comment
              \medskip
              \comment={Data available at http://cave-registry.org.uk/svn/Burrington}
              \the\comment
              \medskip
              \comment={Copyright 2012-2015 CC BY NC SA}
              \the\comment
              }
      \legendbox{110}{-305}{SW}{
            \hsize=\legendwidth
            \formattedlegend
            }

      \legendbox{107}{-305}{NW}{\loadpicture{/media/data/Andrew/Caving/Surveys/Burrington/Reads/Legend.pdf}} 
      \legendbox{0}{100}{NW}{\size[25]Plan View}
      \legendbox{-2}{-5}{NW}{\loadpicture{/media/data/Andrew/Caving/Surveys/Burrington/Reads/ReadsE15.pdf}} 
      \legendbox{-1}{-5}{NE}{\loadpicture{/media/data/Andrew/Caving/Surveys/Burrington/Reads/ReadsE105.pdf}}
      \legendbox{-2}{-208}{NW}{\loadpicture{/media/data/Andrew/Caving/Surveys/Burrington/Reads/ReadsE15_Exploded.pdf}} 
      \legendbox{-1}{-208}{NE}{\loadpicture{/media/data/Andrew/Caving/Surveys/Burrington/Reads/ReadsE105_Exploded.pdf}}
      \legendbox{102}{105}{NW}{\loadpicture{/media/data/Andrew/Caving/Surveys/Burrington/Reads/Reads_Exploded.pdf}}
      \legendbox{150}{-433}{N}{\loadpicture{/media/data/Andrew/Caving/Surveys/Burrington/Reads/LoxExport.png}}  
   }
  
  #map-image -1 65 nw ReadsE15.pdf
  #map-image -1 65 ne ReadsE105.pdf
endcode
endlayout

layout local_elevation15
  copy local_elevation
  colour map-bg [75 90 75]
  symbol-hide point clay #labels to be hidden have been given -context point clay 
code tex-map 
  \def\maplayout{
      \legendbox{0}{92}{SW}{
      \comment={Projected Elevation}
      \size[22]\the\comment
      \comment={Towards 015$^{^{^{^{\circ}}}}$ (up on plan)}
      \smallskip
      \size[18]\the\comment
      }
   }

endlayout

layout local_elevation105
  copy local_elevation
  colour map-bg [75 75 87]
  code tex-map 
  \def\maplayout{
      \legendbox{0}{92}{SW}{
      \comment={Projected Elevation}
      \size[22]\the\comment
      \comment={Towards 105$^{^{^{^{\circ}}}}$ (from left on plan)}
      \smallskip
      \size[18]\the\comment
      }
   }
endlayout

layout local_elevation
  copy mendip
  grid bottom
  grid-size 20 20 10 m
endlayout

layout mendip
grid off
copy common
debug off
scale 1 300
rotate -15
map-header 0 0 off
map-header-bg off
colour map-bg transparent
scale-bar 50 m
#symbol-hide group all
symbol-hide group cave-centreline

overlap 5 mm
colour map-fg map

code metapost


#####################################
#Text sizes
#xs: features such as sumps
#s: point names such as rocks
#m: normal names
#l: major names
#xl: Area/cave names
#####################################
 # for scale 1 300
  fonts_setup(8,12,16,24,40)


endcode
endlayout

input ../common_layout.th
