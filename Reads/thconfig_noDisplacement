encoding  utf-8
source Reads.th

#This file requires pdf files generated by thconfigDisplaced

select LevelsM@Reads -map-level 1 #No displacement with level colour if map level is 1 
#select ReadsM@Reads -map-level 1 #Displaces cave with level colour if map level 1
#select ReadsME15@Reads -map-level 1
#select ReadsME105@Reads -map-level 1
select LevelsME15@Reads -map-level 1
select LevelsME105@Reads -map-level 1

export map -proj [elevation 15] -layout local_elevation15 -o ReadsE15.pdf

export map -proj [elevation 105] -layout local_elevation105 -o ReadsE105.pdf

export map -proj plan -layout local_Plan -o Reads.pdf 

#export map -proj plan -fmt kml -layout mendip -o Reads.kml

#export model -o Reads.lox
